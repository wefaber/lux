# Copia este archivo a .env.local para sobreescribir valores en tu maquina.
# .env.local esta ignorado por git; .env.production no, porque define como se
# buildea el sitio publicado.

# Arranca MSW (los mocks) en un build de produccion.
#
# En desarrollo los mocks estan siempre activos y este flag no hace falta:
# la condicion en src/main.tsx es "import.meta.env.DEV || este flag".
#
# lux.eternum.lat lo necesita en true mientras no exista el backend real. Sin
# mocks el sitio levanta igual, pero el login queda muerto porque /graphql
# responde 405 desde nginx. Cuando exista la API, poner false en
# .env.production y borrar public/mockServiceWorker.js.
VITE_ENABLE_MOCKS=true
