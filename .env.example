# Copia este archivo a .env.local para sobreescribir valores en tu maquina.
# .env.local esta ignorado por git.

# Arranca MSW (los mocks) en el navegador. Es solo para desarrollo local sin
# backend: `bun run dev:mocks` hace lo mismo sin tocar este archivo.
# Ningun deploy (dev.eternum.lat, lux.eternum.lat) usa mocks: el deploy de
# produccion falla si el bundle sale con MSW.
VITE_ENABLE_MOCKS=false

# API a la que `bun dev` reenvia /graphql, /api, /health y /ready.
# Default: la API local (`bun run dev:api`, puerto 4111).
LUX_API_URL=http://127.0.0.1:4111
