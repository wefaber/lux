# Los scripts de administracion se ejecutan en el servidor Debian: deben
# quedar con finales de linea LF aunque se editen desde Windows. Un CRLF en
# la primera linea rompe el shebang con "bad interpreter: /usr/bin/env^M".
*.sh    text eol=lf
scripts/cron/*  text eol=lf
ops/**/*.sh     text eol=lf
ops/backup-server/cron/*  text eol=lf
ops/containers/web/default.conf.template  text eol=lf
# Pruebas y configuracion de shell: se copian al servidor y se corren con bats/shellcheck.
*.bats  text eol=lf
*.bash  text eol=lf
.shellcheckrc  text eol=lf
scripts/tests/bats/stubs/*  text eol=lf
