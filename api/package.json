    "elysia": "^1.3.0",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.13.0",
    "jose": "^6.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "~6.0.2"
  }
}
