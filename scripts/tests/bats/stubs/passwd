#!/usr/bin/env bash
# Stub de passwd: `-S usuario` informa estado (STUB_PASSWD_ESTADO, por defecto P).
# Cualquier otra forma se registra, porque modificaria contrasenas.
if [[ "${1:-}" == "-S" ]]; then
    echo "${2:-usuario} ${STUB_PASSWD_ESTADO:-P} 2026-10-19 0 99999 7 -1"
    exit 0
fi
echo "passwd $*" >> "${STUB_LOG:-/dev/null}"
