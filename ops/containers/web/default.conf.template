# nginx dentro del contenedor `web`: sirve el SPA y proxea /graphql a la API.
# Se procesa con envsubst al arrancar (solo se sustituyen variables de entorno
# definidas; las variables de nginx como $uri no se tocan).

# Resolver dinamico: `api` se vuelve a resolver cada 10 s, asi que al escalar
# (`--scale api=2`) o reemplazar un contenedor no hace falta reiniciar web.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    # Salud del propio contenedor web (healthcheck del compose).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Disponibilidad de la API para verificaciones externas (deploy.sh).
    location = /ready {
        set $api_upstream http://api:4111;
        proxy_pass $api_upstream;
        proxy_connect_timeout 3s;
    }

    location /graphql {
        set $api_upstream http://api:4111;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        # Fallback: si una replica no responde, probar con otra antes de fallar.
        proxy_next_upstream error timeout http_502 http_503;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA: cualquier ruta del cliente vuelve a index.html.
    location / {
        try_files $uri /index.html;
    }
}
