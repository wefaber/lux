# Imagen de la API de Lux (Bun + Elysia + GraphQL Yoga + Drizzle).
# Contexto de build: la raiz del repositorio (ver ops/compose.yaml).
#
# Se instalan tambien las devDependencies porque drizzle-kit (migraciones) es
# una de ellas y el servicio `migrate` usa esta misma imagen.

FROM docker.io/oven/bun:1.4.2-alpine AS deps
WORKDIR /app
COPY api/package.json api/bun.lock ./
RUN bun install --frozen-lockfile

FROM docker.io/oven/bun:1.4.2-alpine
WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=4111
COPY --from=deps /app/node_modules ./node_modules
COPY api/ ./
# La imagen oficial trae el usuario sin privilegios "bun". El stack corre
# ademas rootless en el host: doble capa.
USER bun
EXPOSE 4111
CMD ["bun", "run", "src/index.ts"]
