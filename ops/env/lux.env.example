# Variables del stack de contenedores. Copiar a /etc/sgrsi/lux.env (o a
# ~/.config/sgrsi/lux.env del usuario del stack), con modo 600, y completar.
# Este ARCHIVO DE EJEMPLO no tiene secretos; el real NUNCA se commitea.
#
# Generar valores fuertes, por ejemplo:   openssl rand -base64 32

# Clave del superusuario "postgres" (solo para administracion, via db.sh)
POSTGRES_PASSWORD=[COMPLETAR]
# Rol y base de la aplicacion (la API no usa el superusuario)
LUX_DB_NAME=lux
LUX_DB_USER=lux_app
LUX_DB_PASSWORD=[COMPLETAR]
# Firma de los JWT de la API (HS256). Cambiarla invalida todas las sesiones.
AUTH_SECRET=[COMPLETAR]

# Puerto de loopback donde web publica (el Nginx del host proxea aca)
LUX_WEB_PORT=8080
# NO definir LUX_IMAGE_TAG aca: deploy.sh la pasa por entorno para el rollback
# (vale "latest" por defecto en compose.yaml). Con podman-compose 1.0.6, una
# linea en este archivo pisa el valor y el rollback reinstalaria "latest".
# Replicas de la API (1 a 4). `admin.sh deploy escalar <n>` escribe este valor.
LUX_API_REPLICAS=1
